# Admin dashboard (login + protected API routes)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: override default dev token. Must match token returned from POST /api/auth/login.
# ADMIN_API_TOKEN=

# MongoDB
MONGODB_URI=

# Email (contact form)
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# Public site URL (for Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://localhost:3000

# Cloudinary (uploads) — see lib/cloudinary.ts

# Worklog MCP (/api/mcp) — the credential Claude Code presents.
# Separate from ADMIN_API_TOKEN so it can be revoked without losing dashboard access.
# No default: if this is unset, /api/mcp denies every request.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN=
