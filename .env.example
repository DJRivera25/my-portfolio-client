# Admin dashboard (login + protected API routes)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: override default dev token. Must match token returned from POST /api/auth/login.
# ADMIN_API_TOKEN=

# MongoDB
MONGODB_URI=

# Email (contact form)
EMAIL_USER=
EMAIL_PASS=
EMAIL_TO=

# Public site URL (for Open Graph metadata)
NEXT_PUBLIC_SITE_URL=https://localhost:3000

# Cloudinary (uploads) — see lib/cloudinary.ts

# Optional: project screenshot capture — see lib/screenshot.ts.
# Unset uses the free anonymous allowance (5/day); a free Microlink account key allows 25/day.
# MICROLINK_API_KEY=

# Worklog MCP (/api/mcp) — the credential Claude Code presents.
# Separate from ADMIN_API_TOKEN so it can be revoked without losing dashboard access.
# No default: if this is unset, Claude Code is denied. Leave both this and
# MCP_CLAUDE_AI_TOKEN unset to close /api/mcp entirely.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_TOKEN=
# claude.ai custom connector — its own credential, revocable without touching Claude Code's.
# Paste "Bearer <value>" into the connector's Authorization request header. No default.
# Must differ from MCP_TOKEN, otherwise claude.ai writes are labelled as Claude Code and the
# two cannot be revoked separately.
MCP_CLAUDE_AI_TOKEN=
